"""Application settings for Citerator.

Phase 3 appended retrieval/generation/API settings, Phase 4 appended document
management, Phase 5 appended evaluation. This phase adds a runtime override
bridge: ``base_settings`` reads .env / defaults, ``get_settings`` returns the
effective settings after any persisted overrides are merged on top.
"""

from functools import lru_cache

from pydantic import model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )

    llm_provider: str = "openai"
    openai_api_key: str = ""
    anthropic_api_key: str = ""
    gemini_api_key: str = ""
    llm_model: str = ""

    qdrant_url: str = "http://localhost:6333"
    qdrant_collection: str = "citerator_chunks"
    embedding_model: str = "BAAI/bge-base-en-v1.5"
    rerank_model: str = "cross-encoder/ms-marco-MiniLM-L-6-v2"
    top_k_retrieve: int = 20
    top_k_rerank: int = 5
    confidence_threshold: float = 0.30
    api_key: str = "change-me"

    embedder_kind: str = "bge"
    sparse_kind: str = "bm25"
    active_chunking_strategy: str = "structure"
    confidence_floor: float = 0.15
    cors_origins: list[str] = ["http://localhost:3000"]

    documents_root: str = "data/raw"
    documents_db_path: str = "data/processed/documents.sqlite"
    max_upload_mb: int = 50
    max_concurrent_ingest_jobs: int = 2

    eval_db_path: str = "data/processed/eval.sqlite"
    eval_questions_path: str = "eval/questions.json"
    ragas_llm_provider: str = ""
    ragas_llm_model: str = ""
    max_concurrent_eval_runs: int = 1
    llm_price_per_million_input_tokens: float | None = None
    llm_price_per_million_output_tokens: float | None = None

    runtime_config_db_path: str = "data/processed/runtime_config.sqlite"

    @model_validator(mode="after")
    def _validate_confidence_bands(self) -> "Settings":
        if self.confidence_floor >= self.confidence_threshold:
            raise ValueError("confidence_floor must be less than confidence_threshold")
        return self


@lru_cache
def base_settings() -> Settings:
    """Env-driven defaults, before any runtime overrides are applied."""

    return Settings()


def get_settings() -> Settings:
    """Effective settings: env defaults merged with persisted overrides."""

    from citerator.runtime_config.resolver import effective_settings

    return effective_settings(base_settings)


def _clear_settings_cache() -> None:
    base_settings.cache_clear()
    from citerator.runtime_config.resolver import invalidate

    invalidate()


get_settings.cache_clear = _clear_settings_cache  # type: ignore[attr-defined]
