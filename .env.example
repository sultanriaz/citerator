# ===========================================================================
# Citerator -- environment configuration
# Copy to .env and fill in. Every Settings field is represented.
# ===========================================================================

# --- LLM provider ----------------------------------------------------------
# One of: openai, anthropic, gemini, google, fake
LLM_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model id for the configured provider. Empty uses the provider default.
LLM_MODEL=gemini-3.5-flash-lite

# --- Vector store ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=citerator_chunks

# --- Embedding + rerank models --------------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# One of: bge, openai, hash (must match what ingestion used)
EMBEDDER_KIND=bge
# One of: bm25, hash, none
SPARSE_KIND=bm25

# --- Ingestion -------------------------------------------------------------
# One of: fixed, structure, semantic (must match what ingestion used)
ACTIVE_CHUNKING_STRATEGY=structure

# --- Retrieval / guardrails ------------------------------------------------
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
CONFIDENCE_THRESHOLD=0.30
CONFIDENCE_FLOOR=0.15

# --- API -------------------------------------------------------------------
# Change this before exposing the API. Settings screen can regenerate it.
API_KEY=change-me
# JSON array of allowed CORS origins.
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Documents -------------------------------------------------------------
DOCUMENTS_ROOT=data/raw
DOCUMENTS_DB_PATH=data/processed/documents.sqlite
MAX_UPLOAD_MB=50
MAX_CONCURRENT_INGEST_JOBS=2

# --- Evaluation ------------------------------------------------------------
EVAL_DB_PATH=data/processed/eval.sqlite
EVAL_QUESTIONS_PATH=eval/questions.json
# Judge LLM for Ragas; empty falls back to LLM_PROVIDER / LLM_MODEL.
RAGAS_LLM_PROVIDER=
RAGAS_LLM_MODEL=
MAX_CONCURRENT_EVAL_RUNS=1
# USD per million tokens; leave blank to disable cost estimates.
LLM_PRICE_PER_MILLION_INPUT_TOKENS=
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=

# --- Runtime config --------------------------------------------------------
RUNTIME_CONFIG_DB_PATH=data/processed/runtime_config.sqlite

# --- Observability (Langfuse) ----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to disable tracing even when keys are present.
ENABLE_TRACING=true
OBSERVABILITY_DB_PATH=data/processed/observability.sqlite

# --- Escalations -----------------------------------------------------------
# Optional webhook URL for "Flag for review" / "Escalate to a human".
# Empty disables webhook delivery; escalations still record in SQLite.
ESCALATION_WEBHOOK_URL=
