# --- LLM ---
LLM_PROVIDER=gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=AIza...your-key-here...
LLM_MODEL=gemini-2.0-flash

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=citerator_chunks

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval / guardrail (tune these using the eval set) ---
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
CONFIDENCE_THRESHOLD=0.30
CONFIDENCE_FLOOR=0.15

# --- Ingestion alignment (must match your Phase 2 ingestion run) ---
EMBEDDER_KIND=bge
SPARSE_KIND=bm25
ACTIVE_CHUNKING_STRATEGY=structure

# --- API ---
API_KEY=change-me
CORS_ORIGINS=["http://localhost:3000"]

# --- Tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com