# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=citerator_chunks

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval / guardrail (tune these using the eval set) ---
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
CONFIDENCE_THRESHOLD=0.30

# --- API ---
API_KEY=change-me

# --- Tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com