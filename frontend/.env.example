# Base URL of the Citerator FastAPI backend.
# Matches docker/docker-compose.yml's api service port mapping.
VITE_API_BASE_URL=http://localhost:8000

# Stopgap API key for local development.
# Must match CITERATOR_API_KEY in the backend's root .env.
# The real key-management flow (Regenerate, copy-once) lands in Phase 10,
# wired to the backend's /settings/api endpoints. See docs/settings.md.
VITE_API_KEY=change-me